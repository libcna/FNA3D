@PACKAGE_INIT@

# CNA: the exported targets are FNA3D-targets.cmake, which this file did not include (it looked
# for -shared/-static variants nothing writes), and FNA3D's SDL is SDL3 unless BUILD_SDL3 is off.
if(NOT "@PLATFORM_WIN32@")
	include(CMakeFindDependencyMacro)
	if("@BUILD_SDL3@")
		find_dependency(SDL3 CONFIG)
	else()
		find_dependency(SDL2 CONFIG)
	endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")

check_required_components("@PROJECT_NAME@")
